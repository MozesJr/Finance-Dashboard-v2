# Salin ke deploy/.env.prod (TIDAK di-commit) lalu isi. Jangan pernah commit nilai asli.

# ---- Server ----
NODE_ENV=production
# Hanya untuk deploy.sh / log versi; diisi otomatis oleh deploy.sh
GIT_COMMIT=dev

# ---- Akses web ----
# Port host satu-satunya yang dibuka (nginx). Ubah bila bentrok dengan service lain.
WEB_PORT=8098
# Origin yang diizinkan CORS. Harus persis alamat yang dipakai di browser.
APP_URL=http://148.230.97.68:8098

# ---- HTTP tanpa HTTPS (kondisi saat ini) ----
# false = cookie sesi boleh lewat HTTP biasa. Kode memberi WARNING saat start.
# Setelah HTTPS dipasang: COOKIE_SECURE=true dan TRUST_PROXY=true (lihat docs/DEPLOY.md).
COOKIE_SECURE=false
# Tidak ada reverse proxy di depan nginx web -> false.
TRUST_PROXY=false

# ---- Database (container master_postgresql di network master_db_net) ----
# Database dev = produksi. Backup dulu sebelum migrate (deploy/backup.sh).
DATABASE_URL=postgresql://finance_app:GANTI_PASSWORD@master_postgresql:5432/finance_app

# ---- Auth ----
# BARU, acak, minimal 48 karakter: openssl rand -base64 48
# Mengganti secret ini me-logout semua sesi lama.
JWT_SECRET=GANTI_SECRET_BARU

# ---- LLM (9router di VPS lain, URL publik) ----
LLM_BASE_URL=https://9router.gamabms.tech/v1
LLM_MODEL=smartgov/qwen3.8-27b
LLM_API_KEY=GANTI

# Kuota AI per user per hari (Asia/Jakarta)
AI_LIMIT_CHAT_PER_DAY=30
AI_LIMIT_INSIGHT_PER_DAY=5
AI_LIMIT_RECEIPT_PER_DAY=30
AI_LIMIT_PARSE_PER_DAY=50

# ---- Struk ----
RECEIPT_PARSER=ocr
# Isi hanya jika memakai model vision
RECEIPT_VISION_MODEL=
# Data bahasa OCR dan folder struk sudah diatur oleh image (TESSDATA_DIR, RECEIPT_STORAGE_DIR); jangan diubah.

# ---- Telegram (produksi: token bot LAMA, mode polling) ----
# Hanya SATU instance per token. Jangan men-scale api > 1 dan jangan pakai token ini di Mac.
TELEGRAM_BOT_TOKEN=GANTI
TELEGRAM_MODE=polling
# Opsional: kunci HMAC kode link (default memakai JWT_SECRET)
TELEGRAM_LINK_SECRET=
# Hanya untuk mode webhook (butuh HTTPS)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
