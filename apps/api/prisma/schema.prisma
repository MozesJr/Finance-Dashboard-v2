// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  ADMIN
  USER
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum WalletType {
  CASH
  BANK
  EWALLET
  INVESTMENT
}

enum TxType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
}

enum TxStatus {
  DRAFT
  CONFIRMED
}

enum TxSource {
  WEB
  TELEGRAM
  WHATSAPP
}

enum GoalType {
  EMERGENCY
  INVESTMENT
  CUSTOM
}

enum GoalTargetMode {
  MANUAL
  MONTHS_OF_EXPENSE
}

enum ContributionType {
  DEPOSIT
  WITHDRAW
}

enum AllocationKind {
  EXPENSE
  SAVING
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum AiFeature {
  CHAT
  INSIGHT
  RECEIPT
  PARSE
}

enum AiChatRole {
  USER
  ASSISTANT
}

enum ReceiptStatus {
  PENDING
  PARSED
  FAILED
}

// Models
model User {
  id             String     @id @default(uuid())
  email          String     @unique
  passwordHash   String     @map("password_hash")
  role           Role       @default(USER)
  status         UserStatus @default(PENDING)
  approvedAt     DateTime?  @map("approved_at")
  approvedById   String?    @map("approved_by_id")
  approvedBy     User?      @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvals      User[]     @relation("UserApprovals")
  periodStartDay Int        @default(1) @map("period_start_day")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  refreshTokens        RefreshToken[]
  paydayActions        PaydayAction[]
  bills                Bill[]
  billPayments         BillPayment[]
  wallets              Wallet[]
  categories           Category[]
  transactions         Transaction[]
  receipts             Receipt[]
  savingsGoals         SavingsGoal[]
  savingsContributions SavingsContribution[]
  allocationPlans      AllocationPlan[]
  budgets              Budget[]
  recurringRules       RecurringRule[]
  merchantRules        MerchantCategoryRule[]
  aiInsights           AiInsight[]
  telegramLink         TelegramLink?
  telegramLinkCodes    TelegramLinkCode[]
  auditLogsAsAdmin     AuditLog[]             @relation("AdminAuditLogs")
  BotPendingInput      BotPendingInput[]
  AiUsage              AiUsage[]
  AiChatMessage        AiChatMessage[]

  @@index([approvedById])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") // Track rotation: which token replaced this one
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id           String   @id @default(uuid())
  adminId      String   @map("admin_id")
  admin        User     @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)
  targetUserId String   @map("target_user_id")
  action       String // APPROVE | REJECT | SUSPEND | REACTIVATE
  details      Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([targetUserId])
  @@map("audit_logs")
}

model Wallet {
  id             String     @id @default(uuid())
  userId         String     @map("user_id")
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           WalletType
  color          String?
  isArchived     Boolean    @default(false) @map("is_archived")
  isDefault      Boolean    @default(false) @map("is_default")
  initialBalance BigInt     @default(0) @map("initial_balance")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  transactions Transaction[] @relation("WalletTransactions")
  transfersTo  Transaction[] @relation("TransfersTo")
  savingsGoals SavingsGoal[]
  bills        Bill[]

  @@index([userId])
  @@map("wallets")
}

model Category {
  id        String       @id @default(uuid())
  userId    String?      @map("user_id")
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      CategoryType
  icon      String?
  color     String?
  isSystem  Boolean      @default(false) @map("is_system")
  createdAt DateTime     @default(now()) @map("created_at")

  transactions    Transaction[]
  budgets         Budget[]
  recurringRules  RecurringRule[]
  bills           Bill[]
  merchantRules   MerchantCategoryRule[]
  allocationItems AllocationItemCategory[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Transaction {
  id                  String               @id @default(uuid())
  userId              String               @map("user_id")
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId            String               @map("wallet_id")
  wallet              Wallet               @relation("WalletTransactions", fields: [walletId], references: [id], onDelete: Cascade)
  toWalletId          String?              @map("to_wallet_id")
  toWallet            Wallet?              @relation("TransfersTo", fields: [toWalletId], references: [id], onDelete: SetNull)
  categoryId          String?              @map("category_id")
  category            Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type                TxType
  amount              BigInt
  status              TxStatus             @default(DRAFT)
  merchant            String?
  note                String?
  date                DateTime             @db.Date
  source              TxSource             @default(WEB)
  receiptId           String?              @map("receipt_id")
  receipt             Receipt?             @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  savingsContribution SavingsContribution?
  aiConfidence        Float?               @map("ai_confidence")
  /// Pembagian biaya (hanya EXPENSE): nominal dibagi rata ke N periode berturut-turut untuk laporan.
  spreadPeriods       Int                  @default(1) @map("spread_periods")
  billId              String?              @map("bill_id")
  bill                Bill?                @relation(fields: [billId], references: [id], onDelete: SetNull)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@index([walletId])
  @@index([categoryId])
  @@index([userId, status, date])
  @@index([status, createdAt])
  @@index([billId])
  @@map("transactions")
}

model Receipt {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  filePath   String        @map("file_path")
  mimeType   String        @map("mime_type")
  sizeBytes  Int           @map("size_bytes")
  ocrText    String?       @map("ocr_text")
  parsedJson Json?         @map("parsed_json")
  status     ReceiptStatus @default(PENDING)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  transactions Transaction[]

  @@index([userId])
  @@map("receipts")
}

model SavingsGoal {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         GoalType
  icon         String?
  color        String?
  targetMode   GoalTargetMode @default(MANUAL) @map("target_mode")
  targetAmount BigInt?        @map("target_amount")
  targetMonths Int?           @map("target_months")
  targetDate   DateTime?      @map("target_date") @db.Date
  walletId     String?        @map("wallet_id")
  wallet       Wallet?        @relation(fields: [walletId], references: [id], onDelete: SetNull)
  isArchived   Boolean        @default(false) @map("is_archived")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  contributions   SavingsContribution[]
  allocationItems AllocationItem[]

  @@index([userId])
  @@index([walletId])
  @@map("savings_goals")
}

model SavingsContribution {
  id            String           @id @default(uuid())
  goalId        String           @map("goal_id")
  goal          SavingsGoal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId        String           @map("user_id")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          ContributionType
  amount        BigInt
  date          DateTime         @db.Date
  note          String?
  transactionId String?          @unique @map("transaction_id")
  transaction   Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([goalId])
  @@index([userId])
  @@map("savings_contributions")
}

model AllocationPlan {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyIncome BigInt   @map("monthly_income")
  activePhase   Int      @map("active_phase")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  items AllocationItem[]

  @@unique([userId])
  @@map("allocation_plans")
}

model AllocationItem {
  id           String         @id @default(uuid())
  planId       String         @map("plan_id")
  plan         AllocationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  phase        Int
  name         String
  description  String?
  kind         AllocationKind
  percent      Int // 0-100
  color        String?
  icon         String?
  sortOrder    Int            @default(0) @map("sort_order")
  linkedGoalId String?        @map("linked_goal_id")
  linkedGoal   SavingsGoal?   @relation(fields: [linkedGoalId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now()) @map("created_at")

  categories AllocationItemCategory[]

  @@unique([planId, phase, name])
  @@index([planId])
  @@index([linkedGoalId])
  @@map("allocation_items")
}

model AllocationItemCategory {
  itemId     String         @map("item_id")
  item       AllocationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  categoryId String         @map("category_id")
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([itemId, categoryId])
  @@index([categoryId])
  @@map("allocation_item_categories")
}

model Budget {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     BigInt
  month      DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, categoryId, month])
  @@index([userId])
  @@index([categoryId])
  @@map("budgets")
}

model RecurringRule {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String   @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount      BigInt
  frequency   String // DAILY | WEEKLY | MONTHLY | YEARLY
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([categoryId])
  @@map("recurring_rules")
}

model MerchantCategoryRule {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantPattern String   @map("merchant_pattern")
  categoryId      String   @map("category_id")
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([userId, merchantPattern])
  @@index([userId])
  @@index([categoryId])
  @@map("merchant_category_rules")
}

/// Pemakaian LLM per permintaan user (tanpa isi prompt/respons).
model AiUsage {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature          AiFeature
  promptTokens     Int       @default(0) @map("prompt_tokens")
  completionTokens Int       @default(0) @map("completion_tokens")
  latencyMs        Int       @default(0) @map("latency_ms")
  success          Boolean
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId, feature, createdAt])
  @@map("ai_usage")
}

/// Riwayat percakapan chat AI (hanya teks user/asisten).
model AiChatMessage {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AiChatRole
  content   String
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("ai_chat_messages")
}

model AiInsight {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      String // YYYY-MM format
  kind        String
  content     Json
  generatedAt DateTime @map("generated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, period, kind])
  @@index([userId])
  @@map("ai_insights")
}

/// Input bot yang sudah ter-parse tetapi belum jadi draft (mis. dompet belum dipilih).
model BotPendingInput {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("bot_pending_inputs")
}

model TelegramLink {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId    String   @unique @map("chat_id")
  username  String?
  linkedAt  DateTime @default(now()) @map("linked_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("telegram_links")
}

model TelegramLinkCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash") // HMAC-SHA256 dari kode 6 digit
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([codeHash])
  @@map("telegram_link_codes")
}

/// Aksi checklist gajian yang sudah dijalankan (idempotensi tombol bot/web).
model PaydayAction {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period    String // kunci periode YYYY-MM
  itemKey   String   @map("item_key")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, period, itemKey])
  @@map("payday_actions")
}

/// Tagihan berkala (kos per 3 bulan, asuransi tahunan, ...). Dibayar → transaksi EXPENSE dibagi `intervalMonths` periode.
model Bill {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  amount         BigInt
  categoryId     String?   @map("category_id")
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  walletId       String?   @map("wallet_id")
  wallet         Wallet?   @relation(fields: [walletId], references: [id], onDelete: SetNull)
  intervalMonths Int       @default(1) @map("interval_months")
  /// Hari asli jatuh tempo (1–31); dipakai agar 31 Jan → 28 Feb → 31 Mar tidak bergeser.
  dueDay         Int       @map("due_day")
  nextDueDate    DateTime  @map("next_due_date") @db.Date
  isActive       Boolean   @default(true) @map("is_active")
  remindDays     Int[]     @default([7, 1]) @map("remind_days")
  snoozedUntil   DateTime? @map("snoozed_until") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  payments     BillPayment[]
  reminders    BillReminder[]
  transactions Transaction[]

  @@index([userId])
  @@index([userId, isActive, nextDueDate])
  @@map("bills")
}

model BillPayment {
  id            String   @id @default(uuid())
  billId        String   @map("bill_id")
  bill          Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Unik: satu transaksi hanya boleh menyelesaikan satu pembayaran (idempotensi).
  transactionId String?  @unique @map("transaction_id")
  amount        BigInt
  dueDate       DateTime @map("due_date") @db.Date
  paidOn        DateTime @map("paid_on") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([billId])
  @@index([userId])
  @@map("bill_payments")
}

model BillReminder {
  id         String   @id @default(uuid())
  billId     String   @map("bill_id")
  bill       Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  dueDate    DateTime @map("due_date") @db.Date
  daysBefore Int      @map("days_before")
  sentAt     DateTime @default(now()) @map("sent_at")

  @@unique([billId, dueDate, daysBefore])
  @@map("bill_reminders")
}
