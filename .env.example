# Database
DATABASE_URL=postgresql://finance_app:password@localhost:5433/finance_app

# Auth
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=900
REFRESH_TOKEN_EXPIRY=604800
ADMIN_EMAIL=admin@finance.local
ADMIN_PASSWORD=InitialPassword123!

# LLM
LLM_BASE_URL=https://9router.gamabms.tech/v1
LLM_MODEL=smartgov/qwen3.8-27b
LLM_API_KEY=your-api-key

# Receipt Parser
RECEIPT_PARSER=ocr
RECEIPT_VISION_MODEL=

# Telegram (Phase 4)
# Bot hanya jalan jika token diisi. Jangan commit token asli.
TELEGRAM_BOT_TOKEN=
# polling (dev, default) | webhook (production)
TELEGRAM_MODE=polling
# Mode webhook: secret wajib; URL publik opsional (setWebhook otomatis)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Opsional: kunci HMAC kode link (default memakai JWT_SECRET)
TELEGRAM_LINK_SECRET=
